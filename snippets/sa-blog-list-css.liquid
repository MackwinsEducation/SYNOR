{%- comment -%}
  SYNOR DIARIES — pehla paana ni CSS.

  Aa alag file ma chhe karan aa paana no dekhav haju ghadaay rahyo chhe, ane
  dar vakhate 40 KB nu section pachhu chadhavvu padtu hatu. Have fakt aa
  file badlaay chhe.

  Assets ma na mukaay: section na niyamo `#shopify-section-<id>` thi bandhayela
  chhe ane ek stylesheet e ID ne haravi shakti nathi (docs/desktop-layer.md).
  Section ni andar thi chhapaay to e j ID male chhe.

  Expects: sid, s, f_head, f_body, f_furn
{%- endcomment -%}

<style>
#shopify-section-{{ sid }}{background:{{ s.paper }};
  --dh:{{ f_head }};--d:{{ f_body }};--s:{{ f_furn }};
  font-synthesis-weight:none}
#shopify-section-{{ sid }} .np{font-family:var(--d);font-variation-settings:'opsz' 14;
  color:{{ s.ink }};max-width:{{ s.max }}px;margin:0 auto;
  padding:{{ s.pad_top }}px {{ s.gutter }}px {{ s.pad_bottom }}px}
#shopify-section-{{ sid }} .np *{box-sizing:border-box}
#shopify-section-{{ sid }} .np [data-fam="fresh"]{--c:{{ s.c_fresh }}}
#shopify-section-{{ sid }} .np [data-fam="floral"]{--c:{{ s.c_floral }}}
#shopify-section-{{ sid }} .np [data-fam="woody"]{--c:{{ s.c_woody }}}
#shopify-section-{{ sid }} .np [data-fam="amber"]{--c:{{ s.c_amber }}}
#shopify-section-{{ sid }} .np [data-fam="default"]{--c:{{ s.gold }}}

/* ---- nameplate: jaadi leeti upar, paatli niche ---- */
#shopify-section-{{ sid }} .np-plate{text-align:center;padding-top:5px}
#shopify-section-{{ sid }} .np-ears{display:flex;justify-content:space-between;
  font-family:var(--s);font-size:6.5px;letter-spacing:.2em;text-transform:uppercase;
  color:{{ s.soft }};padding-bottom:8px}
#shopify-section-{{ sid }} .np-nm{font-family:var(--dh);
  font-variation-settings:'SOFT' 0,'WONK' 1,'opsz' 144;font-size:{{ s.nm_m }}px;font-weight:700;
  line-height:.84;letter-spacing:-.045em;margin:0;text-transform:uppercase;color:{{ s.ink }};
  border-top:{{ s.rule_thick }}px solid {{ s.ink }};border-bottom:1px solid {{ s.ink }};
  padding:9px 0 7px}
#shopify-section-{{ sid }} .np-cr{font-family:var(--s);font-size:6.5px;letter-spacing:.3em;
  text-transform:uppercase;color:{{ s.ink2 }};padding:6px 0 0;margin:0}
#shopify-section-{{ sid }} .np-cr em{font-style:normal;color:{{ s.gold }};font-weight:700}

/* ---- dateline ---- */
#shopify-section-{{ sid }} .np-dl{display:flex;justify-content:space-between;gap:8px;
  margin:8px 0 0;padding:4px 0;border-top:1px solid {{ s.rule }};
  border-bottom:2px solid {{ s.ink }};font-family:var(--s);font-size:6.5px;letter-spacing:.16em;
  text-transform:uppercase;color:{{ s.ink2 }};font-variant-numeric:tabular-nums}

/* ---- section patti: paana ni kor sudhi ---- */
#shopify-section-{{ sid }} .np-nav{display:flex;overflow-x:auto;scrollbar-width:none;
  font-family:var(--s);background:{{ s.white }};border-bottom:1px solid {{ s.ink }};
  margin:0 -{{ s.gutter }}px}
#shopify-section-{{ sid }} .np-nav::-webkit-scrollbar{display:none}
#shopify-section-{{ sid }} .np-nav a{flex:none;text-decoration:none;font-size:8.5px;
  letter-spacing:.18em;text-transform:uppercase;color:{{ s.ink2 }};padding:7px 10px;
  font-weight:600;white-space:nowrap;position:relative}
#shopify-section-{{ sid }} .np-nav a+a::before{content:"";position:absolute;left:0;top:7px;
  bottom:7px;width:1px;background:{{ s.rule2 }}}
#shopify-section-{{ sid }} .np-nav a.on{background:{{ s.ink }};color:{{ s.paper }}}

/* ---- havaman nu khanu ---- */
#shopify-section-{{ sid }} .np-wx{margin:10px 0 0;border:1px solid {{ s.ink }};
  font-family:var(--s)}
#shopify-section-{{ sid }} .np-wx-h{display:flex;justify-content:space-between;gap:8px;
  padding:4px 7px;border-bottom:1px solid {{ s.ink }};background:{{ s.paper2 }};
  font-size:6.5px;letter-spacing:.22em;text-transform:uppercase;color:{{ s.ink2 }}}
#shopify-section-{{ sid }} .np-wx-g{display:grid;grid-template-columns:repeat(3,1fr)}
#shopify-section-{{ sid }} .np-wx-g div{padding:6px 2px 7px;text-align:center;
  border-right:1px solid {{ s.rule2 }};border-top:1px solid {{ s.rule2 }};min-width:0}
#shopify-section-{{ sid }} .np-wx-g div:nth-child(-n+3){border-top:0}
#shopify-section-{{ sid }} .np-wx-g div:nth-child(3n){border-right:0}
#shopify-section-{{ sid }} .np-wx-g b{display:block;font-size:5.5px;letter-spacing:.16em;
  text-transform:uppercase;color:{{ s.soft }};font-weight:500}
#shopify-section-{{ sid }} .np-wx-g s{display:block;text-decoration:none;font-family:var(--dh);
  font-variation-settings:'opsz' 36,'WONK' 1;font-size:13px;font-weight:600;margin-top:2px;
  font-variant-numeric:tabular-nums;color:{{ s.ink }}}

/* ---- shreni ni leeti ---- */
#shopify-section-{{ sid }} .np-srul{display:flex;align-items:center;gap:7px;margin:12px 0 0;
  font-family:var(--s);font-size:7px;letter-spacing:.28em;text-transform:uppercase;
  color:{{ s.ink2 }};font-weight:600}
#shopify-section-{{ sid }} .np-srul::after{content:"";height:1px;flex:1;background:{{ s.rule }}}
#shopify-section-{{ sid }} .np-srul i{width:6px;height:6px;background:var(--c,{{ s.gold }});
  display:block;flex:none}

/* ---- mukhya ahevaal ---- */
#shopify-section-{{ sid }} .np-lead{padding:8px 0 0}
#shopify-section-{{ sid }} .np-kick{font-family:var(--s);font-size:7px;letter-spacing:.22em;
  text-transform:uppercase;color:var(--c,{{ s.gold }});font-weight:700;margin:0}
#shopify-section-{{ sid }} .np-h1{font-family:var(--dh);
  font-variation-settings:'SOFT' 0,'WONK' 1,'opsz' 144;font-size:{{ s.h1_m }}px;font-weight:700;
  line-height:.94;letter-spacing:-.04em;margin:7px 0 0}
#shopify-section-{{ sid }} .np-h1 a{color:{{ s.ink }};text-decoration:none}
#shopify-section-{{ sid }} .np-dek{font-family:var(--d);font-variation-settings:'opsz' 24;
  font-size:13px;font-style:italic;line-height:1.4;color:{{ s.ink2 }};margin:8px 0 0}
#shopify-section-{{ sid }} .np-byl{display:flex;gap:7px;flex-wrap:wrap;align-items:center;
  font-family:var(--s);font-size:7px;letter-spacing:.16em;text-transform:uppercase;
  color:{{ s.soft }};margin:9px 0 0;padding:5px 0;border-top:1px solid {{ s.ink }};
  border-bottom:1px solid {{ s.rule }};font-variant-numeric:tabular-nums}
#shopify-section-{{ sid }} .np-film{color:{{ s.ink2 }};font-weight:700}

/* ---- cut: chitra ke film ---- */
#shopify-section-{{ sid }} .ncut{position:relative;display:block;width:100%;margin:10px 0 0;
  background:{{ s.white }};border:1px solid {{ s.rule }};overflow:hidden}
#shopify-section-{{ sid }} .ncut img{width:100%;height:auto;display:block}
#shopify-section-{{ sid }} .ncut-film{aspect-ratio:3/2;cursor:pointer;display:grid;place-items:center}
#shopify-section-{{ sid }} .ncut-th{width:100%;height:100%;object-fit:cover;display:block}
#shopify-section-{{ sid }} .ncut-film iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
#shopify-section-{{ sid }} .ncut-film[data-on] .ncut-th,
#shopify-section-{{ sid }} .ncut-film[data-on] .ncut-go,
#shopify-section-{{ sid }} .ncut-film[data-on] .ncut-mark,
#shopify-section-{{ sid }} .ncut-film[data-on] .ncut-cr{display:none}
#shopify-section-{{ sid }} .ncut-go{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
  width:46px;height:46px;border-radius:50%;border:1px solid {{ s.ink2 }};background:{{ s.white }}b8;
  display:grid;place-items:center;cursor:pointer;padding:0;
  transition:background .2s ease,transform .2s ease}
#shopify-section-{{ sid }} .ncut-film:hover .ncut-go{background:{{ s.ink }};transform:translate(-50%,-50%) scale(1.05)}
#shopify-section-{{ sid }} .ncut-go svg{width:16px;height:16px;fill:{{ s.ink }};margin-left:2px;display:block}
#shopify-section-{{ sid }} .ncut-film:hover .ncut-go svg{fill:{{ s.paper }}}
#shopify-section-{{ sid }} .ncut-mark{position:absolute;left:0;top:0;font-family:var(--s);
  font-size:7px;letter-spacing:.2em;text-transform:uppercase;color:{{ s.ink2 }};
  background:{{ s.paper }};padding:5px 9px;font-weight:700}
#shopify-section-{{ sid }} .ncut-cr{position:absolute;bottom:7px;left:9px;font-family:var(--s);
  font-size:7px;letter-spacing:.18em;text-transform:uppercase;color:{{ s.soft }}}
#shopify-section-{{ sid }} .np-capt{font-family:var(--s);font-size:8px;line-height:1.5;
  color:{{ s.soft }};margin:5px 0 0;padding-bottom:2px;border-bottom:1px solid {{ s.rule2 }}}

/* ---- lakhan: be kolam, chhapa jem ---- */
#shopify-section-{{ sid }} .np-body{margin:10px 0 0;font-variation-settings:'opsz' 11;
  font-size:13px;line-height:1.5;columns:{{ s.lead_cols }};column-gap:14px;
  column-rule:1px solid {{ s.rule2 }}}
#shopify-section-{{ sid }} .np-body p{margin:0}
#shopify-section-{{ sid }} .np-body p::first-letter{font-variation-settings:'opsz' 144,'WONK' 1;
  font-size:34px;line-height:.84;float:left;margin:3px 5px 0 0;font-weight:700;
  color:var(--c,{{ s.gold }})}
#shopify-section-{{ sid }} .np-jump{font-family:var(--s);font-size:7.5px;letter-spacing:.2em;
  text-transform:uppercase;color:var(--c,{{ s.gold }});font-weight:700;padding:5px 0 14px;
  display:block;text-decoration:none}

/* ---- index: chhapa na classifieds ---- */
#shopify-section-{{ sid }} .np-cls{padding-top:10px;border-top:2px solid {{ s.ink }}}
#shopify-section-{{ sid }} .np-ix-h{display:flex;justify-content:space-between;
  align-items:baseline;gap:10px;padding-bottom:6px}
#shopify-section-{{ sid }} .np-ix-h p{font-family:var(--dh);
  font-variation-settings:'SOFT' 0,'WONK' 1,'opsz' 96;font-size:19px;font-weight:700;
  text-transform:uppercase;letter-spacing:-.035em;margin:0}
#shopify-section-{{ sid }} .np-ix-h span{font-family:var(--s);font-size:7px;letter-spacing:.18em;
  text-transform:uppercase;color:{{ s.soft }};white-space:nowrap}
#shopify-section-{{ sid }} .np-tax{display:flex;overflow-x:auto;scrollbar-width:none;
  align-items:center;font-family:var(--s);border-top:1px solid {{ s.ink }};
  border-bottom:1px solid {{ s.rule }};padding:4px 0}
#shopify-section-{{ sid }} .np-tax::-webkit-scrollbar{display:none}
#shopify-section-{{ sid }} .np-tax a{flex:none;text-decoration:none;font-size:8.5px;
  letter-spacing:.14em;text-transform:uppercase;color:{{ s.soft }};padding:5px 8px;
  white-space:nowrap}
#shopify-section-{{ sid }} .np-tax a:first-child{padding-left:0}
#shopify-section-{{ sid }} .np-tax a.on{color:{{ s.ink }};font-weight:700}
#shopify-section-{{ sid }} .np-tax .so{margin-left:auto;flex:none;font-size:8px;
  letter-spacing:.14em;text-transform:uppercase;color:{{ s.ink }};font-weight:700;
  padding-left:10px;white-space:nowrap}

#shopify-section-{{ sid }} .np-row{display:grid;grid-template-columns:16px 1fr auto;gap:2px 8px;
  align-items:baseline;padding:8px 0;border-bottom:1px solid {{ s.rule2 }};
  text-decoration:none;color:{{ s.ink }}}
#shopify-section-{{ sid }} .np-row .sq{width:6px;height:6px;background:var(--c,{{ s.gold }});
  display:block;margin-top:4px}
#shopify-section-{{ sid }} .np-row-t{font-family:var(--dh);
  font-variation-settings:'opsz' 36,'WONK' 1;font-size:13.5px;font-weight:600;line-height:1.16;
  letter-spacing:-.02em}
#shopify-section-{{ sid }} .np-row-d{font-family:var(--s);font-size:7px;color:{{ s.soft }};
  letter-spacing:.06em;white-space:nowrap;text-transform:uppercase;
  font-variant-numeric:tabular-nums}
#shopify-section-{{ sid }} .np-row-m{grid-column:2/-1;font-family:var(--s);font-size:7px;
  letter-spacing:.14em;text-transform:uppercase;color:{{ s.soft }};display:flex;gap:6px;
  flex-wrap:wrap;align-items:center}
#shopify-section-{{ sid }} .np-row-m em{font-style:normal;color:{{ s.ink2 }};font-weight:600}
#shopify-section-{{ sid }} .np-row-m b{color:{{ s.ink2 }};font-weight:700}

#shopify-section-{{ sid }} .np-page{display:flex;align-items:center;justify-content:center;
  gap:16px;margin:14px 0 0;padding-top:12px;border-top:1px solid {{ s.rule }};
  font-family:var(--s);font-size:7.5px;letter-spacing:.24em;text-transform:uppercase;
  color:{{ s.soft }}}
#shopify-section-{{ sid }} .np-page a{color:{{ s.ink }};text-decoration:none;font-weight:700}

/* ---- ek pan post na hoy tyare ---- */
#shopify-section-{{ sid }} .np-none{margin:14px 0 0;padding:44px 20px;text-align:center;
  border-bottom:1px solid {{ s.ink }}}
#shopify-section-{{ sid }} .np-none-h{font-family:var(--dh);
  font-variation-settings:'SOFT' 0,'WONK' 1,'opsz' 144;font-size:26px;font-weight:700;margin:0;
  line-height:1.05;letter-spacing:-.03em;text-transform:uppercase}
#shopify-section-{{ sid }} .np-none-p{font-family:var(--d);font-variation-settings:'opsz' 18;
  font-size:14px;color:{{ s.ink2 }};margin:14px auto 0;max-width:40ch;line-height:1.6}
#shopify-section-{{ sid }} .np-none-b{display:inline-block;margin-top:20px;font-family:var(--s);
  font-size:9.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;
  background:{{ s.ink }};color:{{ s.paper }};padding:12px 22px;text-decoration:none}

#shopify-section-{{ sid }} .np-folio{font-family:var(--s);font-size:7px;letter-spacing:.24em;
  text-transform:uppercase;color:{{ s.soft }};text-align:center;padding:13px 0 0;
  border-top:1px solid {{ s.ink }};margin:12px 0 0}

/* ---------- desktop ---------- */
@media (min-width:900px){
  #shopify-section-{{ sid }} .np{padding:{{ s.pad_top | times: 1.6 | round }}px {{ s.gutter_d }}px {{ s.pad_bottom | times: 1.3 | round }}px}
  #shopify-section-{{ sid }} .np-ears{font-size:9px;padding-bottom:12px}
  #shopify-section-{{ sid }} .np-nm{font-size:{{ s.nm_d }}px;padding:14px 0 11px}
  #shopify-section-{{ sid }} .np-cr{font-size:9px;padding-top:9px}
  #shopify-section-{{ sid }} .np-dl{font-size:8.5px;padding:6px 0;margin-top:12px}
  #shopify-section-{{ sid }} .np-nav{margin:0 -{{ s.gutter_d }}px}
  #shopify-section-{{ sid }} .np-nav a{font-size:9.5px;padding:10px 16px}
  #shopify-section-{{ sid }} .np-wx-h{font-size:8.5px;padding:6px 11px}
  #shopify-section-{{ sid }} .np-wx-g{grid-template-columns:repeat(6,1fr)}
  #shopify-section-{{ sid }} .np-wx-g div{border-top:0;padding:9px 4px 10px}
  #shopify-section-{{ sid }} .np-wx-g div:nth-child(3n){border-right:1px solid {{ s.rule2 }}}
  #shopify-section-{{ sid }} .np-wx-g div:last-child{border-right:0}
  #shopify-section-{{ sid }} .np-wx-g b{font-size:7px}
  #shopify-section-{{ sid }} .np-wx-g s{font-size:19px}
  #shopify-section-{{ sid }} .np-srul{font-size:9px;margin-top:18px}

  /* mukhya ahevaal be bhaag ma khule */
  #shopify-section-{{ sid }} .np-lead{display:grid;grid-template-columns:1.05fr 1fr;
    gap:0 30px;align-items:start;padding-top:14px}
  #shopify-section-{{ sid }} .np-kick,
  #shopify-section-{{ sid }} .np-h1,
  #shopify-section-{{ sid }} .np-dek,
  #shopify-section-{{ sid }} .np-byl,
  #shopify-section-{{ sid }} .np-body,
  #shopify-section-{{ sid }} .np-jump{grid-column:1}
  #shopify-section-{{ sid }} .np-lead .ncut,
  #shopify-section-{{ sid }} .np-capt{grid-column:2}
  #shopify-section-{{ sid }} .np-lead .ncut{grid-row:1/7;margin:4px 0 0}
  #shopify-section-{{ sid }} .np-capt{grid-row:7;font-size:9px}
  #shopify-section-{{ sid }} .np-h1{font-size:{{ s.h1_d }}px}
  #shopify-section-{{ sid }} .np-dek{font-size:17px;line-height:1.45}
  #shopify-section-{{ sid }} .np-byl{font-size:8.5px}
  #shopify-section-{{ sid }} .np-body{font-size:14px;line-height:1.62;columns:2}
  #shopify-section-{{ sid }} .np-body p::first-letter{font-size:40px}
  #shopify-section-{{ sid }} .np-jump{font-size:9px}

  #shopify-section-{{ sid }} .np-ix-h p{font-size:30px}
  #shopify-section-{{ sid }} .np-ix-h span{font-size:8.5px}
  #shopify-section-{{ sid }} .np-tax a{font-size:9.5px;padding:6px 11px}
  #shopify-section-{{ sid }} .np-tax .so{font-size:9px}
  #shopify-section-{{ sid }} .np-row{grid-template-columns:20px 1fr 230px 110px;gap:0 20px;
    padding:12px 0}
  #shopify-section-{{ sid }} .np-row-t{font-size:20px}
  #shopify-section-{{ sid }} .np-row-m{grid-column:3;margin:0;font-size:8px}
  #shopify-section-{{ sid }} .np-row-d{font-size:8px;text-align:right}
  #shopify-section-{{ sid }} .np-none{padding:80px 30px}
  #shopify-section-{{ sid }} .np-none-h{font-size:38px}
  #shopify-section-{{ sid }} .np-folio{font-size:8.5px}
}
</style>
