{%- comment -%}
  SYNOR Diaries — post ni andar product, chhapa ni "classified ad" jem.

  Ek line, ek chorasa, ek kimat, ek button. Chhapa ma classified evi j rite
  chhapaay chhe — ghaatu, sidhu, koi sajavat nahi. Ane e j aa jagya mate
  saachu chhe: vaanchnar ne haju vaanchvu chhe, etle card nu moto block
  aado aave.

  3ml ₹49 agal rakhyu chhe, 100ml pachhal. Hamnaa scent vishe vaanchelo
  mansh ₹49 ne haa pade chhe; ₹1,499 ne vichare chhe. Ane tester j ene
  pachho laave chhe.

  Cart ma sidho nakhvana badle product page par lai jaay chhe (variant
  select thayelu), jethi GoKwik ane bundlr no flow kyay tute nahi.

  Chorasa no rang = product ni fragrance family. E j char rang aakha
  chhapa ma vaparaay chhe, etle ek j bhasha.

  Photo hoy to nano photo, na hoy to pehla jevo rang no chorasa — ad ni
  line kyarey tuti na jaay.

  Vaapar: {% render 'sa-blog-product', product: p, try_label: 'Try 3ml' %}
{%- endcomment -%}

{%- if product != blank and product.available -%}
  {%- liquid
    assign fam = ''
    assign famkey = ''
    assign gender = ''
    assign v_try = null
    assign v_full = null

    for t in product.tags
      assign low = t | downcase
      assign p7 = low | slice: 0, 7
      if p7 == 'family-' and famkey == ''
        assign famkey = low | remove_first: 'family-'
        assign fam = famkey | replace: '-', ' & '
      endif
      assign p6 = low | slice: 0, 6
      if p6 == 'gender' and gender == ''
        assign gender = low | remove_first: 'gender-'
      endif
    endfor

    for v in product.variants
      assign vt = v.title | downcase
      if vt contains '3ml' and v_try == null
        assign v_try = v
      endif
      if vt contains '100ml' and v_full == null
        assign v_full = v
      endif
    endfor

    assign v_try = v_try | default: product.selected_or_first_available_variant
    assign v_full = v_full | default: product.selected_or_first_available_variant

    assign who = gender
    if gender == 'him'
      assign who = 'Him'
    elsif gender == 'her'
      assign who = 'Her'
    elsif gender == 'unisex'
      assign who = 'Anyone'
    endif

    assign swatch = 'default'
    if famkey contains 'fresh' or famkey contains 'aquatic'
      assign swatch = 'fresh'
    elsif famkey contains 'floral' or famkey contains 'fruity'
      assign swatch = 'floral'
    elsif famkey contains 'woody' or famkey contains 'oud'
      assign swatch = 'woody'
    elsif famkey contains 'amber' or famkey contains 'sweet'
      assign swatch = 'amber'
    endif
  -%}

  <div class="nad" data-fam="{{ swatch }}">
    {%- if product.featured_image != blank -%}
      <a class="nad-im" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
        {{ product.featured_image | image_url: width: 180 | image_tag:
             widths: '90,140,180', sizes: '60px', loading: 'lazy', alt: '' }}
      </a>
    {%- else -%}
      <span class="nad-sq" aria-hidden="true"></span>
    {%- endif -%}
    <span class="nad-w">
      <b>{{ product.title | remove_first: 'SYNOR ' }}</b>
      <s>
        {%- if fam != blank -%}{{ fam }}{%- endif -%}
        {%- if fam != blank and who != blank %} &middot; {% endif -%}
        {{ who }}
      </s>
    </span>
    <span class="nad-b">
      <a href="{{ product.url }}?variant={{ v_try.id }}">
        {{ try_label | default: 'Try 3ml' }} {{ v_try.price | money }}
      </a>
      <s>100ml {{ v_full.price | money }}</s>
    </span>
  </div>
{%- endif -%}
