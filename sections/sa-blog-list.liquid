{%- comment -%}
  SYNOR DIARIES — pehlu paanu.

  Aa "A" chhe — chhapa nu kharu pehlu paanu, je pasand thayu hatu: nameplate
  jaadi leeti niche, dateline nu chokathu, section ni patti, havaman nu
  khanu, ane niche Index (chhapa na classifieds jem).

  Ek vaar aa paanu leetio ane chokatha vagar chhapayu hatu — "vadhare
  monghu ane minimal" karva. E bhul hati: leetio, chokatha ane havaman nu
  khanu j aa paana ne chhapu banave chhe. Eni vagar e koi pan blog chhe.
  Etle e badhu pachhu chhe, ane je vaat par matbhed thai shake — phone par
  be column, lead ma ketla shabd, leeti ketli jaadi — e settings chhe, code
  ma bandhayelo mato nathi.

  RANG = FRAGRANCE FAMILY. Juna chhapa kaali shahi ane EK rang ma chhapaata.
  Aa chhapa no e ek rang = post ni fragrance family. Index ma paanch chorasa
  ek sathe dekhaay tyare rang kharekhar bole chhe.

  TAGS (bot ane tu, banne aaj lakho):
    blog | vlog | review | letter   → Index ma kind, ane upar ni patti no filter
    series-<slug>                   → series no bhaag
    yt-<VIDEOID>                    → film (metafield custom.youtube_ids pan chale)
    family-* gender-* occasion-* brand-*  → niche ni patti na filters

  DEKHAV: snippets/sa-blog-list-css.liquid ma chhe. Assets ma na mukaay —
  aa na niyamo ID thi bandhayela chhe (docs/desktop-layer.md jo).

  LATEST: Shopify no blog sada sauthi navo pehlo aape chhe, ane Liquid ma
  kram badalvano koi rasto nathi. Etle kram no ullekh ek lakhan chhe, button
  nathi — khota control mukava karta saachu lakhvu saru.
{%- endcomment -%}

{%- assign s = section.settings -%}
{%- assign sid = section.id -%}

{%- comment -%}
  FONT SET.

  Traan khana: dh = matthaa, d = lakhan, s = nanu uppercase sarjaam.
  Default 'now' e j Fraunces + Space Grotesk chhe, etle setting na badle
  paanu akshare akshar pehla jevu j dekhaay chhe.

  Aa badlaav fakt blog na paana ne j lage chhe: aa section potaano
  stylesheet jaate maange chhe, etle baaki no store adto nathi.

  font-synthesis-weight:none — jene 700 nu kharu akshar na hoy, e
  browser jaate jaadu kari aape chhe ane e kharaab dekhaay. Etle nahi.
{%- endcomment -%}

{%- liquid
  assign f_head = '"Fraunces",Georgia,serif'
  assign f_body = '"Fraunces",Georgia,serif'
  assign f_furn = '"Space Grotesk",system-ui,sans-serif'
  assign gf = 'family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..900,0..100,0..1;1,9..144,300..900,0..100,0..1&amp;family=Space+Grotesk:wght@400;500;600;700'

  case s.font_set
    when 'caslon'
      assign f_head = '"Libre Caslon Display",Georgia,serif'
      assign f_body = '"Libre Caslon Text",Georgia,serif'
      assign f_furn = '"Libre Franklin",system-ui,sans-serif'
      assign gf = 'family=Libre+Caslon+Display&amp;family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&amp;family=Libre+Franklin:wght@400;500;600;700;800'
    when 'bodoni'
      assign f_head = '"Bodoni Moda",Didot,Georgia,serif'
      assign f_body = '"Bodoni Moda",Didot,Georgia,serif'
      assign f_furn = '"Archivo",system-ui,sans-serif'
      assign gf = 'family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&amp;family=Archivo:wght@400;500;600;700;800;900'
    when 'newsreader'
      assign f_head = '"Newsreader",Georgia,serif'
      assign f_body = '"Newsreader",Georgia,serif'
      assign f_furn = '"Public Sans",system-ui,sans-serif'
      assign gf = 'family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&amp;family=Public+Sans:wght@400;500;600;700;800'
    when 'instrument'
      assign f_head = '"Instrument Serif",Georgia,serif'
      assign f_body = '"Instrument Serif",Georgia,serif'
      assign f_furn = '"Inter Tight",system-ui,sans-serif'
      assign gf = 'family=Instrument+Serif:ital@0;1&amp;family=Inter+Tight:wght@400;500;600;700;800;900'
    when 'tabloid'
      assign f_head = '"Anton",Impact,sans-serif'
      assign f_body = '"Newsreader",Georgia,serif'
      assign f_furn = '"Archivo",system-ui,sans-serif'
      assign gf = 'family=Anton&amp;family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&amp;family=Archivo:wght@400;500;600;700;800;900'
    when 'bricolage'
      assign f_head = '"Bricolage Grotesque",system-ui,sans-serif'
      assign f_body = '"Bricolage Grotesque",system-ui,sans-serif'
      assign f_furn = '"Instrument Sans",system-ui,sans-serif'
      assign gf = 'family=Bricolage+Grotesque:opsz,wght@12..96,200..800&amp;family=Instrument+Sans:wght@400;500;600;700'
    when 'custom'
      assign gf = ''
      if s.cf_head != blank
        assign nh = s.cf_head | strip
        assign f_head = nh | prepend: '"' | append: '",Georgia,serif'
        assign gf = nh | replace: ' ', '+' | prepend: 'family='
      endif
      if s.cf_body != blank
        assign nb = s.cf_body | strip
        assign f_body = nb | prepend: '"' | append: '",Georgia,serif'
        assign one = nb | replace: ' ', '+' | prepend: 'family='
        if gf == ''
          assign gf = one
        else
          assign gf = gf | append: '&amp;' | append: one
        endif
      endif
      if s.cf_furn != blank
        assign nf = s.cf_furn | strip
        assign f_furn = nf | prepend: '"' | append: '",system-ui,sans-serif'
        assign one = nf | replace: ' ', '+' | prepend: 'family='
        if gf == ''
          assign gf = one
        else
          assign gf = gf | append: '&amp;' | append: one
        endif
      endif
      comment
        Koi pan khanu khali hoy to eno ghar no font joishe, etle e
        stylesheet pan maangvo pade.
      endcomment
      assign need_house = false
      if s.cf_head == blank or s.cf_body == blank or s.cf_furn == blank
        assign need_house = true
      endif
      if need_house
        if gf == ''
          assign gf = 'family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..900,0..100,0..1;1,9..144,300..900,0..100,0..1&amp;family=Space+Grotesk:wght@400;500;600;700'
        else
          assign gf = gf | append: '&amp;family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..900,0..100,0..1;1,9..144,300..900,0..100,0..1&amp;family=Space+Grotesk:wght@400;500;600;700'
        endif
      endif
  endcase
-%}

{%- liquid
  assign filtered = false
  if current_tags and current_tags.size > 0
    assign filtered = true
  endif

  assign cur = ''
  if filtered
    assign cur = current_tags | first | downcase
  endif

  assign n_entries = blog.articles_count
  assign word_count = s.word_entries
  if n_entries == 1
    assign word_count = s.word_entry
  endif
-%}

{%- if gf != blank -%}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?{{ gf }}&amp;display=swap">
{%- endif -%}

<div class="np">

  {%- comment -%}
    ---- nameplate ----
    Jaadi leeti upar, paatli niche. E be leetio j chhapa ne chhapu banave
    chhe; eni vagar aa koi pan blog nu matthu chhe.
  {%- endcomment -%}
  <header class="np-plate">
    <div class="np-ears">
      <span>{{ s.ear_left }}</span>
      <span>{{ s.ear_right }}</span>
    </div>
    <h1 class="np-nm">{{ s.paper_name | default: blog.title }}</h1>
    {%- if s.creed != blank -%}
      <p class="np-cr">{{ s.creed | replace: '[', '<em>' | replace: ']', '</em>' }}</p>
    {%- endif -%}
  </header>

  {%- comment -%} ---- dateline: traan khana, be leeti vacche ---- {%- endcomment -%}
  <div class="np-dl">
    <span>{{ s.vol }}</span>
    <span>
      {%- if filtered -%}
        {{ cur | replace: '-', ' ' }}
      {%- else -%}
        {{ 'now' | date: s.date_long }}
      {%- endif -%}
    </span>
    <span>{{ n_entries }} {{ word_count }}</span>
  </div>

  {%- comment -%}
    Section patti. Dareki ek tag chhe, etle Shopify nu tagged URL j kaam kare
    chhe — koi navu template ke app ni jarur nahi. Chalu shreni kaala
    chorasa ma bese, ane vacche ubhi leetio — chhapa ni patti evi j hoy.
  {%- endcomment -%}
  <nav class="np-nav" aria-label="{{ s.word_sections | escape }}">
    <a href="{{ blog.url }}"{% unless filtered %} class="on" aria-current="page"{% endunless %}>{{ s.word_all }}</a>
    {%- assign kinds = 'blog,vlog,series,review,letter' | split: ',' -%}
    {%- for k in kinds -%}
      {%- liquid
        assign kl = ''
        case k
          when 'blog'
            assign kl = s.word_blog
          when 'vlog'
            assign kl = s.word_vlog
          when 'series'
            assign kl = s.word_series
          when 'review'
            assign kl = s.word_review
          when 'letter'
            assign kl = s.word_letters
        endcase
      -%}
      <a href="{{ blog.url }}/tagged/{{ k }}"{% if cur == k %} class="on" aria-current="page"{% endif %}>{{ kl }}</a>
    {%- endfor -%}
  </nav>

  {%- paginate blog.articles by s.per_page -%}

    {%- if blog.articles.size == 0 -%}

      <div class="np-none">
        <p class="np-none-h">{{ s.empty_title }}</p>
        <p class="np-none-p">{{ s.empty_text }}</p>
        {%- if s.empty_link != blank -%}
          <a class="np-none-b" href="{{ s.empty_link }}">{{ s.empty_btn }}</a>
        {%- endif -%}
      </div>

    {%- else -%}

      {%- liquid
        assign total = blog.articles_count
        assign page_back = paginate.current_page | minus: 1
        assign offset = page_back | times: s.per_page
        assign show_lead = false
        if s.lead_first and paginate.current_page == 1 and filtered == false
          assign show_lead = true
        endif
      -%}

      {%- comment -%}
        Index ni rows alag capture ma bane chhe, karan Index nu matthu ane
        filter patti tyare j chhapvi jethi niche kaik hoy. Ek j post hoy
        tyare khali "Index" ane khali filter patti dekhaay e kharaab chhe.
      {%- endcomment -%}
      {%- capture rows -%}
        {%- for a in blog.articles -%}
          {%- liquid
            assign skip = false
            if show_lead and forloop.first
              assign skip = true
            endif
          -%}
          {%- unless skip -%}
            {%- liquid
              assign kind = ''
              assign yt = ''
              assign famkey = ''
              assign place = a.metafields.custom.field_place.value

              for t in a.tags
                assign low = t | downcase
                if low == 'vlog' or low == 'blog' or low == 'review' or low == 'letter'
                  assign kind = low
                endif
                assign k3 = low | slice: 0, 3
                if k3 == 'yt-' and yt == ''
                  assign yt = t | slice: 3, 40
                endif
                assign k7 = low | slice: 0, 7
                if k7 == 'family-' and famkey == ''
                  assign famkey = low | remove_first: 'family-'
                endif
              endfor

              assign mf_yt = a.metafields.custom.youtube_ids.value
              if mf_yt != blank and yt == ''
                assign yt = 'y'
              endif

              assign fam = 'default'
              if famkey contains 'fresh' or famkey contains 'aquatic'
                assign fam = 'fresh'
              elsif famkey contains 'floral' or famkey contains 'fruity'
                assign fam = 'floral'
              elsif famkey contains 'woody' or famkey contains 'oud'
                assign fam = 'woody'
              elsif famkey contains 'amber' or famkey contains 'sweet'
                assign fam = 'amber'
              endif

              assign kl = s.word_blog
              if kind == 'vlog'
                assign kl = s.word_vlog
              elsif kind == 'review'
                assign kl = s.word_review
              elsif kind == 'letter'
                assign kl = s.word_letters
              endif

              assign words = a.content | strip_html | split: ' ' | size
              assign rt = words | divided_by: 200 | at_least: 1
            -%}
            <a class="np-row" href="{{ a.url }}" data-fam="{{ fam }}">
              <span class="sq" aria-hidden="true"></span>
              <span class="np-row-t">{{ a.title }}</span>
              <span class="np-row-d">{{ a.published_at | date: s.date_short }}</span>
              <span class="np-row-m">
                <em>{{ kl }}</em>
                {%- if yt != blank -%}<b>&#9654;&nbsp;{{ s.word_film }}</b>{%- endif -%}
                {%- if place != blank -%}<span>{{ place }}</span>{%- endif -%}
                <span>{{ rt }} {{ s.word_read }}</span>
              </span>
            </a>
          {%- endunless -%}
        {%- endfor -%}
      {%- endcapture -%}

      {%- if show_lead -%}
        {%- for a in blog.articles limit: 1 -%}
          {%- liquid
            assign kind = ''
            assign series = ''
            assign yt = ''
            assign famkey = ''
            assign place = a.metafields.custom.field_place.value

            for t in a.tags
              assign low = t | downcase
              if low == 'vlog' or low == 'blog' or low == 'review' or low == 'letter'
                assign kind = low
              endif
              assign k3 = low | slice: 0, 3
              if k3 == 'yt-' and yt == ''
                assign yt = t | slice: 3, 40
              endif
              assign k7 = low | slice: 0, 7
              if k7 == 'series-'
                assign series = low | slice: 7, 120
              elsif k7 == 'family-' and famkey == ''
                assign famkey = low | remove_first: 'family-'
              endif
            endfor

            assign mf_yt = a.metafields.custom.youtube_ids.value
            if mf_yt != blank and yt == ''
              assign ids = mf_yt | replace: ' ', '' | split: ','
              assign yt = ids | first
            endif

            assign fam = 'default'
            if famkey contains 'fresh' or famkey contains 'aquatic'
              assign fam = 'fresh'
            elsif famkey contains 'floral' or famkey contains 'fruity'
              assign fam = 'floral'
            elsif famkey contains 'woody' or famkey contains 'oud'
              assign fam = 'woody'
            elsif famkey contains 'amber' or famkey contains 'sweet'
              assign fam = 'amber'
            endif

            assign kl = s.word_blog
            if kind == 'vlog'
              assign kl = s.word_vlog
            elsif kind == 'review'
              assign kl = s.word_review
            elsif kind == 'letter'
              assign kl = s.word_letters
            endif

            assign fam_label = ''
            if famkey != blank
              assign fam_label = famkey | replace: '-', ' & '
            endif

            assign words = a.content | strip_html | split: ' ' | size
            assign rt = words | divided_by: 200 | at_least: 1
          -%}

          {%- comment -%} Havaman nu khanu — chhapa na khune je hoy e. {%- endcomment -%}
          {%- render 'sa-blog-fieldbox', article: a, s: s -%}

          {%- comment -%} Shreni ni leeti: chorasa, shabd, ane khali leeti. {%- endcomment -%}
          <p class="np-srul" data-fam="{{ fam }}"><i aria-hidden="true"></i>{{ kl }}</p>

          <article class="np-lead" data-fam="{{ fam }}">
            <p class="np-kick">
              {{ kl }}
              {%- if fam_label != blank %} &middot; {{ fam_label }}{% endif -%}
              {%- if series != blank %} &middot; {{ series | replace: '-', ' ' }}{% endif -%}
            </p>

            <h2 class="np-h1"><a href="{{ a.url }}">{{ a.title }}</a></h2>

            {%- if a.excerpt != blank -%}
              <p class="np-dek">{{ a.excerpt | strip_html | truncatewords: 22 }}</p>
            {%- endif -%}

            <p class="np-byl">
              {%- if place != blank -%}<span>{{ place }}</span>{%- endif -%}
              <time datetime="{{ a.published_at | date: '%Y-%m-%d' }}">{{ a.published_at | date: s.date_short }}</time>
              <span>{{ rt }} {{ s.word_read }}</span>
              {%- if yt != blank -%}<span class="np-film">&#9654;&nbsp;{{ s.word_film }}</span>{%- endif -%}
            </p>

            {%- if yt != blank -%}
              {%- render 'sa-blog-video', id: yt, title: a.title -%}
            {%- elsif a.image -%}
              <a class="ncut" href="{{ a.url }}">
                {{ a.image | image_url: width: 1200 | image_tag:
                     widths: '480,720,1000,1200', sizes: '(min-width: 900px) 520px, 100vw',
                     loading: 'eager', fetchpriority: 'high', alt: a.title | escape }}
              </a>
            {%- endif -%}

            {%- if yt != blank or a.image -%}
              {%- if s.capt != blank -%}<p class="np-capt">{{ s.capt }}</p>{%- endif -%}
            {%- endif -%}

            {%- if a.content != blank -%}
              <div class="np-body">
                <p>{{ a.content | strip_html | truncatewords: s.lead_words }}</p>
              </div>
            {%- endif -%}

            <a class="np-jump" href="{{ a.url }}">{{ s.word_full }} &rarr;</a>
          </article>
        {%- endfor -%}
      {%- endif -%}

      {%- assign rows_t = rows | strip -%}
      {%- if rows_t != blank -%}
        <div class="np-cls">
          <div class="np-ix-h">
            <p>{{ s.word_index }}</p>
            <span>{{ n_entries }} {{ word_count }}</span>
          </div>
          {%- render 'sa-blog-taxbar', blog: blog, current_tags: current_tags, sort_label: s.word_latest -%}
          {{ rows }}
        </div>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="np-page" aria-label="{{ s.word_pages | escape }}">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}">{{ s.word_newer }}</a>
          {%- endif -%}
          <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}">{{ s.word_older }}</a>
          {%- endif -%}
        </nav>
      {%- endif -%}

    {%- endif -%}
  {%- endpaginate -%}

  <p class="np-folio">
    {{ s.paper_name | default: blog.title }}
    {%- if s.vol != blank %} &middot; {{ s.vol }}{% endif -%}
    &middot; {{ shop.domain }}
  </p>
</div>

{%- comment -%} Dekhav alag file ma — docs/blog-layer.md jo. {%- endcomment -%}
{%- render 'sa-blog-list-css', sid: sid, s: s,
     f_head: f_head, f_body: f_body, f_furn: f_furn -%}

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ sid }}');
  if (!root) return;
  /* Film: click thay tyare j YouTube andar aave. */
  root.addEventListener('click', function (e) {
    var box = e.target.closest('.ncut-film');
    if (!box || box.dataset.on) return;
    var id = box.dataset.yt;
    if (!id) return;
    box.dataset.on = '1';
    var f = document.createElement('iframe');
    f.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0&playsinline=1';
    f.title = {{ s.word_film | json }};
    f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    f.allowFullscreen = true;
    f.loading = 'lazy';
    box.appendChild(f);
  });
})();
</script>

{% schema %}
{
  "name": "Diaries list — SYNOR",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Chhapa nu pehlu paanu. Post na tags: blog · vlog · review · letter · series-<slug> · yt-<VIDEOID> · family-* gender-* occasion-* brand-*" },

    { "type": "header", "content": "Nameplate" },
    { "type": "text", "id": "paper_name", "label": "Paper name (blank = blog name)" },
    { "type": "text", "id": "creed", "label": "Line under the name — [brackets] go gold", "default": "For the [Synorians]" },
    { "type": "text", "id": "ear_left", "label": "Top left", "default": "Synor · Est. 2026" },
    { "type": "text", "id": "ear_right", "label": "Top right", "default": "₹49 a tester" },
    { "type": "text", "id": "vol", "label": "Volume line", "default": "Vol. I" },
    { "type": "text", "id": "date_long", "label": "Date format · long", "default": "%A, %d %B %Y" },
    { "type": "text", "id": "date_short", "label": "Date format · short", "default": "%d %b" },
    { "type": "range", "id": "rule_thick", "min": 1, "max": 6, "step": 1, "unit": "px", "label": "Rule above the name", "default": 3 },

    { "type": "header", "content": "Section words" },
    { "type": "text", "id": "word_all", "label": "All", "default": "All" },
    { "type": "text", "id": "word_blog", "label": "Blog", "default": "Blog" },
    { "type": "text", "id": "word_vlog", "label": "Vlog", "default": "Vlog" },
    { "type": "text", "id": "word_series", "label": "Series", "default": "Series" },
    { "type": "text", "id": "word_review", "label": "Review", "default": "Review" },
    { "type": "text", "id": "word_letters", "label": "Letters", "default": "Letters" },
    { "type": "text", "id": "word_sections", "label": "Nav label (for screen readers)", "default": "Sections" },

    { "type": "header", "content": "Other words" },
    { "type": "text", "id": "word_index", "label": "Index heading", "default": "Index" },
    { "type": "text", "id": "word_entry", "label": "Count word · one", "default": "entry" },
    { "type": "text", "id": "word_entries", "label": "Count word · many", "default": "entries" },
    { "type": "text", "id": "word_latest", "label": "Order note", "default": "Latest ▾" },
    { "type": "text", "id": "word_read", "label": "Reading time", "default": "min read" },
    { "type": "text", "id": "word_film", "label": "Film mark", "default": "Film" },
    { "type": "text", "id": "word_full", "label": "Read-on link", "default": "Read the full report" },
    { "type": "text", "id": "word_field", "label": "Field box heading", "default": "Today's field" },
    { "type": "text", "id": "word_pages", "label": "Pagination label", "default": "Pages" },
    { "type": "text", "id": "word_newer", "label": "Newer", "default": "Newer" },
    { "type": "text", "id": "word_older", "label": "Older", "default": "Older" },

    { "type": "header", "content": "Lead report" },
    { "type": "checkbox", "id": "lead_first", "label": "Newest entry as the lead report", "default": true },
    { "type": "text", "id": "lead_fields", "label": "Field box cells", "default": "temp,humidity,alt,held,asked,verdict" },
    { "type": "select", "id": "lead_cols", "label": "Lead text columns · mobile", "default": "2",
      "options": [ { "value": "1", "label": "One" }, { "value": "2", "label": "Two" } ] },
