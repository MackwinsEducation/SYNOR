{%- comment -%}
  SYNOR DIARIES — pehlu paanu.

  Blog listing chhapa na pehla paana jem chhe: nameplate, dateline, ek mukhya
  ahevaal, ane niche Index (chhapa na classifieds jem) — badhi entries ek
  najar ma.

  "A-fine": chhapu ochhi leetio, vadhare khali jagya ane ochho rang thi
  monghu laage chhe. Etle ahiya jaadi leetio nathi, chokatha nathi, ane
  phone par be column nu nanu lakhan nathi (e sauthi sasta newsprint ni
  nishani chhe). Vaanchvanu post ma chhe, listing ma nathi.

  RANG = FRAGRANCE FAMILY. Juna chhapa kaali shahi ane EK rang ma chhapaata.
  Aa chhapa no e ek rang = post ni fragrance family. Index ma paanch chorasa
  ek sathe dekhaay tyare rang kharekhar bole chhe.

  TAGS (bot ane tu, banne aaj lakho):
    blog | vlog | review | letter   → Index ma kind, ane upar ni patti no filter
    series-<slug>                   → series no bhaag
    yt-<VIDEOID>                    → film (metafield custom.youtube_ids pan chale)
    family-* gender-* occasion-* brand-*  → niche ni patti na filters

  LATEST: Shopify no blog sada sauthi navo pehlo aape chhe, ane Liquid ma
  kram badalvano koi rasto nathi. Etle "Latest first" ek lakhan chhe, button
  nathi — khota control mukava karta saachu lakhvu saru.
{%- endcomment -%}

{%- assign s = section.settings -%}
{%- assign sid = section.id -%}

{%- comment -%}
  FONT SET.

  Traan khana: dh = matthaa, d = lakhan, s = nanu uppercase sarjaam.
  Default 'now' e j Fraunces + Space Grotesk chhe, etle setting na badle
  paanu akshare akshar pehla jevu j dekhaay chhe.

  Aa badlaav fakt blog na paana ne j lage chhe: aa section potaano
  stylesheet jaate maange chhe, etle baaki no store adto nathi.

  font-synthesis-weight:none — jene 700 nu kharu akshar na hoy, e
  browser jaate jaadu kari aape chhe ane e kharaab dekhaay. Etle nahi.
{%- endcomment -%}

{%- liquid
  assign f_head = '"Fraunces",Georgia,serif'
  assign f_body = '"Fraunces",Georgia,serif'
  assign f_furn = '"Space Grotesk",system-ui,sans-serif'
  assign gf = 'family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..900,0..100,0..1;1,9..144,300..900,0..100,0..1&amp;family=Space+Grotesk:wght@400;500;600;700'

  case s.font_set
    when 'caslon'
      assign f_head = '"Libre Caslon Display",Georgia,serif'
      assign f_body = '"Libre Caslon Text",Georgia,serif'
      assign f_furn = '"Libre Franklin",system-ui,sans-serif'
      assign gf = 'family=Libre+Caslon+Display&amp;family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&amp;family=Libre+Franklin:wght@400;500;600;700;800'
    when 'bodoni'
      assign f_head = '"Bodoni Moda",Didot,Georgia,serif'
      assign f_body = '"Bodoni Moda",Didot,Georgia,serif'
      assign f_furn = '"Archivo",system-ui,sans-serif'
      assign gf = 'family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&amp;family=Archivo:wght@400;500;600;700;800;900'
    when 'newsreader'
      assign f_head = '"Newsreader",Georgia,serif'
      assign f_body = '"Newsreader",Georgia,serif'
      assign f_furn = '"Public Sans",system-ui,sans-serif'
      assign gf = 'family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&amp;family=Public+Sans:wght@400;500;600;700;800'
    when 'instrument'
      assign f_head = '"Instrument Serif",Georgia,serif'
      assign f_body = '"Instrument Serif",Georgia,serif'
      assign f_furn = '"Inter Tight",system-ui,sans-serif'
      assign gf = 'family=Instrument+Serif:ital@0;1&amp;family=Inter+Tight:wght@400;500;600;700;800;900'
    when 'tabloid'
      assign f_head = '"Anton",Impact,sans-serif'
      assign f_body = '"Newsreader",Georgia,serif'
      assign f_furn = '"Archivo",system-ui,sans-serif'
      assign gf = 'family=Anton&amp;family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&amp;family=Archivo:wght@400;500;600;700;800;900'
    when 'bricolage'
      assign f_head = '"Bricolage Grotesque",system-ui,sans-serif'
      assign f_body = '"Bricolage Grotesque",system-ui,sans-serif'
      assign f_furn = '"Instrument Sans",system-ui,sans-serif'
      assign gf = 'family=Bricolage+Grotesque:opsz,wght@12..96,200..800&amp;family=Instrument+Sans:wght@400;500;600;700'
    when 'custom'
      assign gf = ''
      if s.cf_head != blank
        assign nh = s.cf_head | strip
        assign f_head = nh | prepend: '"' | append: '",Georgia,serif'
        assign gf = nh | replace: ' ', '+' | prepend: 'family='
      endif
      if s.cf_body != blank
        assign nb = s.cf_body | strip
        assign f_body = nb | prepend: '"' | append: '",Georgia,serif'
        assign one = nb | replace: ' ', '+' | prepend: 'family='
        if gf == ''
          assign gf = one
        else
          assign gf = gf | append: '&amp;' | append: one
        endif
      endif
      if s.cf_furn != blank
        assign nf = s.cf_furn | strip
        assign f_furn = nf | prepend: '"' | append: '",system-ui,sans-serif'
        assign one = nf | replace: ' ', '+' | prepend: 'family='
        if gf == ''
          assign gf = one
        else
          assign gf = gf | append: '&amp;' | append: one
        endif
      endif
      comment
        Koi pan khanu khali hoy to eno ghar no font joishe, etle e
        stylesheet pan maangvo pade.
      endcomment
      assign need_house = false
      if s.cf_head == blank or s.cf_body == blank or s.cf_furn == blank
        assign need_house = true
      endif
      if need_house
        if gf == ''
          assign gf = 'family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..900,0..100,0..1;1,9..144,300..900,0..100,0..1&amp;family=Space+Grotesk:wght@400;500;600;700'
        else
          assign gf = gf | append: '&amp;family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..900,0..100,0..1;1,9..144,300..900,0..100,0..1&amp;family=Space+Grotesk:wght@400;500;600;700'
        endif
      endif
  endcase
-%}

{%- liquid
  assign filtered = false
  if current_tags and current_tags.size > 0
    assign filtered = true
  endif

  assign cur = ''
  if filtered
    assign cur = current_tags | first | downcase
  endif
-%}

{%- if gf != blank -%}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?{{ gf }}&amp;display=swap">
{%- endif -%}

<div class="np">

  {%- comment -%} ---- nameplate ---- {%- endcomment -%}
  <header class="np-plate">
    <div class="np-ears">
      <span>{{ s.ear_left }}</span>
      <span>{{ s.ear_right }}</span>
    </div>
    <h1 class="np-nm">{{ s.paper_name | default: blog.title }}</h1>
    {%- if s.creed != blank -%}
      <p class="np-creed">{{ s.creed }}</p>
    {%- endif -%}
  </header>

  <div class="np-hair"></div>

  {%- comment -%}
    Section patti. Dareki ek tag chhe, etle Shopify nu tagged URL j kaam kare
    chhe — koi navu template ke app ni jarur nahi.
  {%- endcomment -%}
  <nav class="np-nav" aria-label="{{ s.word_sections | escape }}">
    <a href="{{ blog.url }}"{% unless filtered %} class="on" aria-current="page"{% endunless %}>{{ s.word_all }}</a>
    {%- assign kinds = 'blog,vlog,series,review,letter' | split: ',' -%}
    {%- for k in kinds -%}
      {%- liquid
        assign kl = ''
        case k
          when 'blog'
            assign kl = s.word_blog
          when 'vlog'
            assign kl = s.word_vlog
          when 'series'
            assign kl = s.word_series
          when 'review'
            assign kl = s.word_review
          when 'letter'
            assign kl = s.word_letters
        endcase
      -%}
      <a href="{{ blog.url }}/tagged/{{ k }}"{% if cur == k %} class="on" aria-current="page"{% endif %}>{{ kl }}</a>
    {%- endfor -%}
  </nav>

  <div class="np-hair np-hair2"></div>

  <p class="np-dline">
    {%- if s.vol != blank -%}{{ s.vol }} &middot; {% endif -%}
    {%- if filtered -%}
      {{ cur | replace: '-', ' ' }}
    {%- else -%}
      {{ 'now' | date: s.date_long }}
    {%- endif -%}
    {%- if blog.articles_count > 0 %} &middot; {{ blog.articles_count }} {{ s.word_entries }}{% endif -%}
  </p>

  {%- paginate blog.articles by s.per_page -%}

    {%- if blog.articles.size == 0 -%}

      <div class="np-none">
        <p class="np-none-h">{{ s.empty_title }}</p>
        <p class="np-none-p">{{ s.empty_text }}</p>
        {%- if s.empty_link != blank -%}
          <a class="np-none-b" href="{{ s.empty_link }}">{{ s.empty_btn }}</a>
        {%- endif -%}
      </div>

    {%- else -%}

      {%- liquid
        assign total = blog.articles_count
        assign page_back = paginate.current_page | minus: 1
        assign offset = page_back | times: s.per_page
        assign show_lead = false
        if s.lead_first and paginate.current_page == 1 and filtered == false
          assign show_lead = true
        endif
      -%}

      {%- for a in blog.articles -%}
        {%- liquid
          assign kind = ''
          assign series = ''
          assign yt = ''
          assign famkey = ''
          assign place = a.metafields.custom.field_place.value

          for t in a.tags
            assign low = t | downcase
            if low == 'vlog' or low == 'blog' or low == 'review' or low == 'letter'
              assign kind = low
            endif
            assign k3 = low | slice: 0, 3
            if k3 == 'yt-' and yt == ''
              assign yt = t | slice: 3, 40
            endif
            assign k7 = low | slice: 0, 7
            if k7 == 'series-'
              assign series = low | slice: 7, 120
            elsif k7 == 'family-' and famkey == ''
              assign famkey = low | remove_first: 'family-'
            endif
          endfor

          assign mf_yt = a.metafields.custom.youtube_ids.value
          if mf_yt != blank and yt == ''
            assign ids = mf_yt | replace: ' ', '' | split: ','
            assign yt = ids | first
          endif

          assign fam = 'default'
          if famkey contains 'fresh' or famkey contains 'aquatic'
            assign fam = 'fresh'
          elsif famkey contains 'floral' or famkey contains 'fruity'
            assign fam = 'floral'
          elsif famkey contains 'woody' or famkey contains 'oud'
            assign fam = 'woody'
          elsif famkey contains 'amber' or famkey contains 'sweet'
            assign fam = 'amber'
          endif

          assign kl = s.word_blog
          if kind == 'vlog'
            assign kl = s.word_vlog
          elsif kind == 'review'
            assign kl = s.word_review
          elsif kind == 'letter'
            assign kl = s.word_letters
          endif

          assign words = a.content | strip_html | split: ' ' | size
          assign rt = words | divided_by: 200 | at_least: 1

          assign no = total | minus: offset | minus: forloop.index0
          assign no_pad = no
          if no < 10
            assign no_pad = no | prepend: '0'
          endif
        -%}

        {%- if show_lead and forloop.first -%}

          {%- comment -%} ---- mukhya ahevaal ---- {%- endcomment -%}
          <article class="np-lead" data-fam="{{ fam }}">
            <p class="np-kick">
              <i aria-hidden="true"></i>{{ kl }}
              {%- if place != blank %} &middot; {{ place }}{% endif -%}
              {%- if series != blank %} &middot; {{ series | replace: '-', ' ' }}{% endif -%}
            </p>

            <h2 class="np-h1"><a href="{{ a.url }}">{{ a.title }}</a></h2>

            {%- if yt != blank -%}
              {%- render 'sa-blog-video', id: yt, title: a.title -%}
            {%- elsif a.image -%}
              <a class="ncut" href="{{ a.url }}">
                {{ a.image | image_url: width: 1200 | image_tag:
                     widths: '480,720,1000,1200', sizes: '(min-width: 900px) 520px, 100vw',
                     loading: 'eager', fetchpriority: 'high', alt: a.title | escape }}
              </a>
            {%- endif -%}

            {%- if a.excerpt_or_content != blank -%}
              <p class="np-stand">{{ a.excerpt_or_content | strip_html | truncatewords: 34 }}</p>
            {%- endif -%}

            <p class="np-byl">
              <time datetime="{{ a.published_at | date: '%Y-%m-%d' }}">{{ a.published_at | date: s.date_long }}</time>
              <span>{{ rt }} {{ s.word_read }}</span>
              {%- if yt != blank -%}<span class="np-film">&#9654;&nbsp;{{ s.word_film }}</span>{%- endif -%}
            </p>

            <a class="np-jump" href="{{ a.url }}">{{ s.word_full }}</a>
          </article>

          {%- render 'sa-blog-field', article: a, keys: s.lead_fields -%}

          <div class="np-ix-open">
            <div class="np-ix-h">
              <p>{{ s.word_index }}</p>
              <span>{{ s.word_latest }}</span>
            </div>
            {%- render 'sa-blog-taxbar', blog: blog, current_tags: current_tags -%}
          </div>

        {%- else -%}

          {%- if forloop.first -%}
            <div class="np-ix-open">
              <div class="np-ix-h">
                <p>{{ s.word_index }}</p>
                <span>{{ s.word_latest }}</span>
              </div>
              {%- render 'sa-blog-taxbar', blog: blog, current_tags: current_tags -%}
            </div>
          {%- endif -%}

          <a class="np-row" href="{{ a.url }}" data-fam="{{ fam }}">
            <span class="np-row-t">{{ a.title }}</span>
            <span class="np-row-d">{{ a.published_at | date: s.date_short }}</span>
            <span class="np-row-m">
              <i aria-hidden="true"></i>{{ kl }}
              {%- if yt != blank -%}<b>&#9654;&nbsp;{{ s.word_film }}</b>{%- endif -%}
              {%- if place != blank -%}<span>{{ place }}</span>{%- endif -%}
              <span>{{ rt }} {{ s.word_read }}</span>
            </span>
          </a>

        {%- endif -%}
      {%- endfor -%}

      {%- if paginate.pages > 1 -%}
        <nav class="np-page" aria-label="{{ s.word_pages | escape }}">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}">{{ s.word_newer }}</a>
          {%- endif -%}
          <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}">{{ s.word_older }}</a>
          {%- endif -%}
        </nav>
      {%- endif -%}

    {%- endif -%}
  {%- endpaginate -%}

  <p class="np-folio">
    {{ s.paper_name | default: blog.title }}
    {%- if s.vol != blank %} &middot; {{ s.vol }}{% endif -%}
    &middot; {{ shop.domain }}
  </p>
</div>

<style>
#shopify-section-{{ sid }}{background:{{ s.paper }};
  --dh:{{ f_head }};--d:{{ f_body }};--s:{{ f_furn }};
  font-synthesis-weight:none}
#shopify-section-{{ sid }} .np{font-family:var(--d);font-variation-settings:'opsz' 14;
  color:{{ s.ink }};max-width:{{ s.max }}px;margin:0 auto;
  padding:{{ s.pad_top }}px {{ s.gutter }}px {{ s.pad_bottom }}px}
#shopify-section-{{ sid }} .np *{box-sizing:border-box}
#shopify-section-{{ sid }} .np [data-fam="fresh"]{--c:{{ s.c_fresh }}}
#shopify-section-{{ sid }} .np [data-fam="floral"]{--c:{{ s.c_floral }}}
#shopify-section-{{ sid }} .np [data-fam="woody"]{--c:{{ s.c_woody }}}
#shopify-section-{{ sid }} .np [data-fam="amber"]{--c:{{ s.c_amber }}}
#shopify-section-{{ sid }} .np [data-fam="default"]{--c:{{ s.gold }}}

/* ---- nameplate: koi jaadi leeti nahi ---- */
#shopify-section-{{ sid }} .np-plate{text-align:center;padding-top:8px}
#shopify-section-{{ sid }} .np-ears{display:flex;justify-content:space-between;
  font-family:var(--s);font-size:7px;letter-spacing:.24em;
  text-transform:uppercase;color:{{ s.soft }};padding-bottom:18px}
#shopify-section-{{ sid }} .np-nm{font-family:var(--dh);
  font-variation-settings:'SOFT' 0,'WONK' 1,'opsz' 144;font-size:{{ s.nm_m }}px;font-weight:500;
  line-height:.9;letter-spacing:-.025em;margin:0;text-transform:uppercase;color:{{ s.ink }}}
#shopify-section-{{ sid }} .np-creed{font-family:var(--s);font-size:7px;
  letter-spacing:.34em;text-transform:uppercase;color:{{ s.soft }};margin:15px 0 0}
#shopify-section-{{ sid }} .np-hair{height:1px;background:{{ s.rule }};margin:22px 0 0}
#shopify-section-{{ sid }} .np-hair2{margin:0}

/* ---- section patti ---- */
#shopify-section-{{ sid }} .np-nav{display:flex;overflow-x:auto;scrollbar-width:none;
  justify-content:center;font-family:var(--s)}
#shopify-section-{{ sid }} .np-nav::-webkit-scrollbar{display:none}
#shopify-section-{{ sid }} .np-nav a{flex:none;text-decoration:none;font-size:8px;letter-spacing:.22em;
  text-transform:uppercase;color:{{ s.soft }};padding:11px 10px;font-weight:500;white-space:nowrap}
#shopify-section-{{ sid }} .np-nav a.on{color:{{ s.ink }};font-weight:700}
#shopify-section-{{ sid }} .np-dline{font-family:var(--s);font-size:6.5px;
  letter-spacing:.26em;text-transform:uppercase;color:{{ s.soft }};text-align:center;margin:16px 0 0;
  font-variant-numeric:tabular-nums}

/* ---- mukhya ahevaal ---- */
#shopify-section-{{ sid }} .np-lead{padding:26px 0 0}
#shopify-section-{{ sid }} .np-kick{display:flex;align-items:center;gap:8px;flex-wrap:wrap;
  font-family:var(--s);font-size:7px;letter-spacing:.28em;
  text-transform:uppercase;color:{{ s.ink2 }};font-weight:600;margin:0}
#shopify-section-{{ sid }} .np-kick i{width:6px;height:6px;background:var(--c,{{ s.gold }});
  display:block;flex:none}
#shopify-section-{{ sid }} .np-h1{font-family:var(--dh);
  font-variation-settings:'SOFT' 0,'WONK' 1,'opsz' 144;font-size:{{ s.h1_m }}px;font-weight:500;
  line-height:1;letter-spacing:-.035em;margin:15px 0 0}
#shopify-section-{{ sid }} .np-h1 a{color:{{ s.ink }};text-decoration:none}
#shopify-section-{{ sid }} .np-stand{font-family:var(--d);
  font-variation-settings:'opsz' 18,'WONK' 0;font-size:15px;line-height:1.66;color:{{ s.ink2 }};
  margin:18px 0 0}
#shopify-section-{{ sid }} .np-byl{display:flex;gap:10px;flex-wrap:wrap;align-items:center;
  font-family:var(--s);font-size:7px;letter-spacing:.2em;
  text-transform:uppercase;color:{{ s.soft }};margin:18px 0 0}
#shopify-section-{{ sid }} .np-film{color:{{ s.ink2 }};font-weight:700}
#shopify-section-{{ sid }} .np-jump{font-family:var(--s);font-size:7.5px;
  letter-spacing:.24em;text-transform:uppercase;color:{{ s.ink }};font-weight:700;margin:18px 0 0;
  display:inline-block;text-decoration:none;border-bottom:1px solid {{ s.ink }};padding-bottom:2px}

/* ---- cut: chitra ke film ---- */
#shopify-section-{{ sid }} .ncut{position:relative;display:block;width:100%;margin:22px 0 0;
  background:{{ s.white }};overflow:hidden}
#shopify-section-{{ sid }} .ncut img{width:100%;height:auto;display:block}
#shopify-section-{{ sid }} .ncut-film{aspect-ratio:3/2;cursor:pointer;display:grid;place-items:center}
#shopify-section-{{ sid }} .ncut-th{width:100%;height:100%;object-fit:cover;display:block}
#shopify-section-{{ sid }} .ncut-film iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
#shopify-section-{{ sid }} .ncut-film[data-on] .ncut-th,
#shopify-section-{{ sid }} .ncut-film[data-on] .ncut-go,
#shopify-section-{{ sid }} .ncut-film[data-on] .ncut-mark,
#shopify-section-{{ sid }} .ncut-film[data-on] .ncut-cr{display:none}
#shopify-section-{{ sid }} .ncut-go{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
  width:52px;height:52px;border-radius:50%;border:1px solid {{ s.ink2 }};background:{{ s.paper }}e6;
  display:grid;place-items:center;cursor:pointer;padding:0;
  transition:background .2s ease,transform .2s ease}
#shopify-section-{{ sid }} .ncut-film:hover .ncut-go{background:{{ s.ink }};transform:translate(-50%,-50%) scale(1.05)}
#shopify-section-{{ sid }} .ncut-go svg{width:18px;height:18px;fill:{{ s.ink }};margin-left:2px;display:block}
#shopify-section-{{ sid }} .ncut-film:hover .ncut-go svg{fill:{{ s.paper }}}
#shopify-section-{{ sid }} .ncut-mark{position:absolute;left:0;top:0;
  font-family:var(--s);font-size:7px;letter-spacing:.2em;
  text-transform:uppercase;color:{{ s.ink2 }};background:{{ s.paper }};padding:5px 9px;font-weight:700}
#shopify-section-{{ sid }} .ncut-cr{position:absolute;bottom:7px;left:9px;
  font-family:var(--s);font-size:7px;letter-spacing:.16em;
  text-transform:uppercase;color:{{ s.soft }}}

/* ---- field log: be paatli leeti vacche ---- */
#shopify-section-{{ sid }} .nfield{display:flex;margin:30px 0 0;padding:14px 0;
  border-top:1px solid {{ s.rule }};border-bottom:1px solid {{ s.rule }};
  font-family:var(--s)}
#shopify-section-{{ sid }} .nfield div{flex:1;text-align:center;position:relative;min-width:0}
#shopify-section-{{ sid }} .nfield div+div::before{content:"";position:absolute;left:0;top:2px;
  bottom:2px;width:1px;background:{{ s.rule2 }}}
#shopify-section-{{ sid }} .nfield b{display:block;font-size:6px;letter-spacing:.2em;
  text-transform:uppercase;color:{{ s.soft }};font-weight:500}
#shopify-section-{{ sid }} .nfield s{display:block;text-decoration:none;font-family:var(--dh);
  font-variation-settings:'opsz' 36,'WONK' 0;font-size:15px;font-weight:400;margin-top:5px;
  font-variant-numeric:tabular-nums;letter-spacing:-.01em;color:{{ s.ink }}}

/* ---- index ---- */
#shopify-section-{{ sid }} .np-ix-open{margin:34px 0 0}
#shopify-section-{{ sid }} .np-ix-h{display:flex;justify-content:space-between;align-items:baseline;
  padding-bottom:12px}
#shopify-section-{{ sid }} .np-ix-h p{font-family:var(--dh);
  font-variation-settings:'SOFT' 0,'WONK' 1,'opsz' 96;font-size:22px;font-weight:500;
  letter-spacing:-.028em;text-transform:uppercase;margin:0}
#shopify-section-{{ sid }} .np-ix-h span{font-family:var(--s);font-size:6.5px;
  letter-spacing:.22em;text-transform:uppercase;color:{{ s.soft }}}
#shopify-section-{{ sid }} .np-tax{display:flex;overflow-x:auto;scrollbar-width:none;
  font-family:var(--s);padding:0 0 4px}
#shopify-section-{{ sid }} .np-tax::-webkit-scrollbar{display:none}
#shopify-section-{{ sid }} .np-tax a{flex:none;text-decoration:none;font-size:8px;letter-spacing:.18em;
  text-transform:uppercase;color:{{ s.soft }};padding:4px 9px;white-space:nowrap}
#shopify-section-{{ sid }} .np-tax a:first-child{padding-left:0}
#shopify-section-{{ sid }} .np-tax a.on{color:{{ s.ink }};font-weight:700}

#shopify-section-{{ sid }} .np-row{display:grid;grid-template-columns:1fr auto;gap:7px 12px;
  align-items:baseline;padding:17px 0;border-top:1px solid {{ s.rule2 }};text-decoration:none;
  color:{{ s.ink }}}
#shopify-section-{{ sid }} .np-row-t{font-family:var(--dh);
  font-variation-settings:'opsz' 36,'WONK' 1;font-size:16px;font-weight:500;line-height:1.22;
  letter-spacing:-.022em}
#shopify-section-{{ sid }} .np-row-d{font-family:var(--s);font-size:6.5px;
  letter-spacing:.18em;text-transform:uppercase;color:{{ s.soft }};white-space:nowrap;
  font-variant-numeric:tabular-nums}
#shopify-section-{{ sid }} .np-row-m{grid-column:1/-1;display:flex;gap:9px;align-items:center;
  flex-wrap:wrap;font-family:var(--s);font-size:6.5px;letter-spacing:.22em;
  text-transform:uppercase;color:{{ s.soft }}}
#shopify-section-{{ sid }} .np-row-m i{width:5px;height:5px;background:var(--c,{{ s.gold }});
  display:block;flex:none}
#shopify-section-{{ sid }} .np-row-m b{color:{{ s.ink2 }};font-weight:700}

#shopify-section-{{ sid }} .np-page{display:flex;align-items:center;justify-content:center;gap:16px;
  margin:26px 0 0;padding-top:24px;border-top:1px solid {{ s.rule2 }};
  font-family:var(--s);font-size:7.5px;letter-spacing:.24em;
  text-transform:uppercase;color:{{ s.soft }}}
#shopify-section-{{ sid }} .np-page a{color:{{ s.ink }};text-decoration:none;font-weight:700}

/* ---- ek pan post na hoy tyare ---- */
#shopify-section-{{ sid }} .np-none{margin:40px 0 0;padding:44px 20px;text-align:center;
  border-top:1px solid {{ s.rule }};border-bottom:1px solid {{ s.rule }}}
#shopify-section-{{ sid }} .np-none-h{font-family:var(--dh);
  font-variation-settings:'SOFT' 0,'WONK' 1,'opsz' 144;font-size:26px;font-weight:500;margin:0;
  line-height:1.05;letter-spacing:-.03em}
#shopify-section-{{ sid }} .np-none-p{font-family:var(--d);
  font-variation-settings:'opsz' 18;font-size:14px;color:{{ s.ink2 }};margin:14px auto 0;max-width:40ch;
  line-height:1.6}
#shopify-section-{{ sid }} .np-none-b{display:inline-block;margin-top:20px;
  font-family:var(--s);font-size:9.5px;font-weight:700;letter-spacing:.16em;
  text-transform:uppercase;background:{{ s.ink }};color:{{ s.paper }};padding:12px 22px;
  text-decoration:none}

#shopify-section-{{ sid }} .np-folio{font-family:var(--s);font-size:6.5px;
  letter-spacing:.28em;text-transform:uppercase;color:{{ s.soft }};text-align:center;
  padding:34px 0 0;margin:0}

/* ---------- desktop ---------- */
@media (min-width:900px){
  #shopify-section-{{ sid }} .np{padding:{{ s.pad_top | times: 1.6 | round }}px {{ s.gutter_d }}px {{ s.pad_bottom | times: 1.3 | round }}px}
  #shopify-section-{{ sid }} .np-ears{font-size:9px;padding-bottom:26px}
  #shopify-section-{{ sid }} .np-nm{font-size:{{ s.nm_d }}px}
  #shopify-section-{{ sid }} .np-creed{font-size:9px}
  #shopify-section-{{ sid }} .np-nav a{font-size:9.5px;padding:13px 14px}
  #shopify-section-{{ sid }} .np-dline{font-size:8.5px}

  /* mukhya ahevaal be bhaag ma khule */
  #shopify-section-{{ sid }} .np-lead{display:grid;grid-template-columns:1.05fr 1fr;
    gap:0 38px;align-items:start;padding-top:38px}
  #shopify-section-{{ sid }} .np-kick,
  #shopify-section-{{ sid }} .np-h1,
  #shopify-section-{{ sid }} .np-stand,
  #shopify-section-{{ sid }} .np-byl,
  #shopify-section-{{ sid }} .np-jump{grid-column:1}
  #shopify-section-{{ sid }} .np-lead .ncut{grid-column:2;grid-row:1/7;margin:4px 0 0}
  #shopify-section-{{ sid }} .np-h1{font-size:{{ s.h1_d }}px}
  #shopify-section-{{ sid }} .np-stand{font-size:17px;line-height:1.7}
  #shopify-section-{{ sid }} .np-byl{font-size:8.5px}
  #shopify-section-{{ sid }} .np-jump{font-size:9px;justify-self:start}

  #shopify-section-{{ sid }} .nfield s{font-size:19px}
  #shopify-section-{{ sid }} .nfield b{font-size:7.5px}
  #shopify-section-{{ sid }} .np-ix-h p{font-size:32px}
  #shopify-section-{{ sid }} .np-ix-h span{font-size:8.5px}
  #shopify-section-{{ sid }} .np-tax a{font-size:9.5px;padding:5px 11px}

  #shopify-section-{{ sid }} .np-row{grid-template-columns:1fr 230px 110px;gap:0 24px;padding:20px 0}
  #shopify-section-{{ sid }} .np-row-t{font-size:21px}
  #shopify-section-{{ sid }} .np-row-m{grid-column:2;margin:0;font-size:8px}
  #shopify-section-{{ sid }} .np-row-d{font-size:8px;text-align:right}
  #shopify-section-{{ sid }} .np-none{padding:80px 30px}
  #shopify-section-{{ sid }} .np-none-h{font-size:38px}
}
</style>

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ sid }}');
  if (!root) return;
  /* Film: click thay tyare j YouTube andar aave. */
  root.addEventListener('click', function (e) {
    var box = e.target.closest('.ncut-film');
    if (!box || box.dataset.on) return;
    var id = box.dataset.yt;
    if (!id) return;
    box.dataset.on = '1';
    var f = document.createElement('iframe');
    f.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0&playsinline=1';
    f.title = {{ s.word_film | json }};
    f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    f.allowFullscreen = true;
    f.loading = 'lazy';
    box.appendChild(f);
  });
})();
</script>

