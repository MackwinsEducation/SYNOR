    { "type": "range", "id": "h1_d", "min": 28, "max": 60, "step": 1, "unit": "px", "label": "Title · desktop", "default": 42 },
    { "type": "range", "id": "h2_m", "min": 15, "max": 28, "step": 1, "unit": "px", "label": "Heading · mobile", "default": 19 },
    { "type": "range", "id": "h2_d", "min": 18, "max": 36, "step": 1, "unit": "px", "label": "Heading · desktop", "default": 25 },
    { "type": "range", "id": "body_m", "min": 13, "max": 19, "step": 1, "unit": "px", "label": "Text · mobile", "default": 15 },
    { "type": "range", "id": "body_d", "min": 15, "max": 22, "step": 1, "unit": "px", "label": "Text · desktop", "default": 17 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFDF9" },
    { "type": "color", "id": "card", "label": "Card face", "default": "#FFFFFF" },
    { "type": "color", "id": "tint", "label": "Soft panel", "default": "#F7F4EC" },
    { "type": "color", "id": "line", "label": "Lines", "default": "#E5DFD1" },
    { "type": "color", "id": "ink", "label": "Text", "default": "#1A1712" },
    { "type": "color", "id": "soft", "label": "Muted text", "default": "#6E6656" },
    { "type": "color", "id": "gold", "label": "Gold", "default": "#BE9A54" },
    { "type": "color", "id": "on_gold", "label": "Text on gold", "default": "#FFFDF9" },
    { "type": "color", "id": "link", "label": "Links", "default": "#A8873F" }
  ]
}
{% endschema %}
