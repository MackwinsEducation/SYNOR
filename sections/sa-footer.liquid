{%- comment -%} SYNOR — Footer. Torn letter, wax seal, handwritten note. {%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign sid = section.id -%}

<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

{% render 'sa-footer-css', sid: sid, s: s %}
{% render 'sa-footer-tear', sid: sid, s: s %}

<footer class="ft">

  <div class="twine" aria-hidden="true">
    <img class="twineimg"
      {% if s.twine %}src="{{ s.twine | image_url: width: 1600 }}"{% endif %}
      alt="">
  </div>

  {%- comment -%}
    ── the rope at desktop ──
    The phone photo is a bow on a short length of rope, about 3.9 wide to 1
    tall. It is sized by width, so asking it to cross a 1920px window also
    makes it 410px tall: half of that lands on the note and half climbs out of
    the footer. A rope that runs the whole width has to be drawn that way —
    long and thin, with the bow in the middle — so it gets its own photo.

    It is painted as a background rather than a second <img> because the box is
    then free to be `100vw` tall-cropped: `cover` sizes the artwork by HEIGHT,
    so the rope keeps one thickness and the bow one size at every window width,
    and only the flat rope at the two ends is cropped away. Nothing here runs
    below 900px, so the phone is untouched.
  {%- endcomment -%}
  {%- if s.twine_d != blank -%}
    {%- assign twh = s.twine_d_h | default: 170 -%}
    {%- assign tear = s.tear_pad | default: 58 -%}
    <style>
      @media screen and (min-width: 900px) {
        #shopify-section-{{ sid }} .ft .twine {
          width: 100vw !important;
          height: {{ twh }}px !important;
          background-image: url("{{ s.twine_d | image_url: width: 3000 }}");
          background-size: cover;
          background-position: center center;
          background-repeat: no-repeat;
          filter: drop-shadow(0 4px 7px rgba(90, 72, 40, .28));
        }

        #shopify-section-{{ sid }} .ft .twineimg { display: none }

        {%- comment -%}
          The rope is centred ON the tear, so half its height is always above
          the paper and half below it. Both the footer's head-room and the
          note's are measured from that half, not guessed.
        {%- endcomment -%}
        #shopify-section-{{ sid }} .ft {
          padding-top: max({{ s.pad_top | default: 40 }}px, calc({{ twh }}px / 2 + 16px)) !important;
        }

        #shopify-section-{{ sid }} .ft .note {
          padding-top: max(20px, calc({{ twh }}px / 2 + 45px - {{ tear }}px)) !important;
        }
      }
    </style>
  {%- endif -%}

  <div class="stamp{% if s.seal %} hasphoto{% endif %}">
    <svg viewBox="0 0 200 200" aria-label="{{ shop.name | escape }}">
      <defs>
        <path id="ring-{{ sid }}" d="M100,102 m-63,0 a63,63 0 1,1 126,0 a63,63 0 1,1 -126,0"/>
        <radialGradient id="wax-{{ sid }}" cx="36%" cy="28%" r="78%">
          <stop offset="0%" stop-color="#F0D9A2"/>
          <stop offset="26%" stop-color="#D4B06A"/>
          <stop offset="62%" stop-color="#AC8541"/>
          <stop offset="88%" stop-color="#7E5F2A"/>
          <stop offset="100%" stop-color="#63491F"/>
        </radialGradient>
        <radialGradient id="well-{{ sid }}" cx="50%" cy="42%" r="62%">
          <stop offset="0%" stop-color="#8E6C31" stop-opacity=".55"/>
          <stop offset="70%" stop-color="#8E6C31" stop-opacity=".12"/>
          <stop offset="100%" stop-color="#8E6C31" stop-opacity="0"/>
        </radialGradient>
        <linearGradient id="rim-{{ sid }}" x1="18%" y1="10%" x2="80%" y2="92%">
          <stop offset="0%" stop-color="#FFF3D6" stop-opacity=".75"/>
          <stop offset="42%" stop-color="#FFF3D6" stop-opacity="0"/>
          <stop offset="100%" stop-color="#4C3616" stop-opacity=".45"/>
        </linearGradient>
        <path id="blob-{{ sid }}" d="M100,8 c17,0 24,-6 38,1 c14,7 11,17 21,26 c10,9 22,11 24,26 c2,15 -9,20 -9,34 c0,14 12,20 8,34 c-4,14 -17,12 -27,22 c-10,10 -10,22 -24,26 c-14,4 -20,-6 -34,-6 c-14,0 -21,10 -35,5 c-14,-5 -13,-17 -23,-27 c-10,-10 -22,-11 -25,-26 c-3,-15 8,-21 8,-35 c0,-14 -11,-20 -7,-34 c4,-14 17,-13 27,-23 c10,-10 10,-19 24,-23 c9,-2.6 16.5,0 34,0 z"/>
      </defs>
      <use href="#blob-{{ sid }}" fill="url(#wax-{{ sid }})"/>
      <use href="#blob-{{ sid }}" fill="url(#rim-{{ sid }})"/>
      <use href="#blob-{{ sid }}" fill="none" stroke="#5A4119" stroke-width="1.2" opacity=".5"/>
      <circle cx="100" cy="100" r="74" fill="url(#well-{{ sid }})"/>
      <circle cx="100" cy="102" r="72" fill="none" stroke="#5C441C" stroke-width="1.4" opacity=".38"/>
      <circle cx="100" cy="101" r="71" fill="none" stroke="#FFE9BE" stroke-width=".9" opacity=".3"/>
      <text fill="#FFF0CD" font-family="'Space Grotesk',sans-serif" font-size="11" font-weight="700" letter-spacing="4.9" opacity=".82">
        <textPath href="#ring-{{ sid }}" startOffset="1">{{ s.seal_text }}</textPath>
      </text>
      <g transform="translate(100,104)">
        <circle r="40" fill="none" stroke="#5C441C" stroke-width="1.1" opacity=".34"/>
        {%- unless s.seal_logo -%}
        <g transform="translate(0,2)">
          <text text-anchor="middle" dominant-baseline="central" font-family="Fraunces,Georgia,serif" font-size="46" font-weight="500" fill="#4A3413" opacity=".5" transform="translate(0,1.6)">{{ s.seal_letter }}</text>
          <text text-anchor="middle" dominant-baseline="central" font-family="Fraunces,Georgia,serif" font-size="46" font-weight="500" fill="#FFF3D8">{{ s.seal_letter }}</text>
        </g>
        {%- endunless -%}
      </g>
    </svg>

    {%- if s.seal -%}
      <img class="sealimg" src="{{ s.seal | image_url: width: 500 }}" alt="">
    {%- endif -%}
    {%- if s.seal_logo -%}
      <img class="crestimg" src="{{ s.seal_logo | image_url: width: 300 }}" alt="">
    {%- endif -%}
  </div>

  <div class="sheet">
    <span class="grain"></span>

    <div class="note">
      <p class="hand">{{ s.note }}</p>
      <div class="sign">
        {%- if s.sign_image -%}
          <img class="signimg" src="{{ s.sign_image | image_url: width: 400 }}" alt="">
        {%- else -%}
          <span class="ink">{{ s.sign_text }}</span>
        {%- endif -%}
        {%- if s.show_pen -%}<span class="pen"></span>{%- endif -%}
      </div>
    </div>

    <div class="panel">
      <div class="inset">

        <div class="crest">
          {%- if s.logo -%}
            <img class="logo" src="{{ s.logo | image_url: width: 600 }}" alt="{{ shop.name | escape }}">
          {%- else -%}
            <div class="word">{{ s.wordmark | replace: '|', '<i>' | replace: '~', '</i>' }}</div>
          {%- endif -%}
          {%- if s.tagline != blank -%}<div class="sub">{{ s.tagline }}</div>{%- endif -%}
        </div>

        <div class="page">
          <div class="entry">
            {%- for b in section.blocks -%}
              {%- if b.type == 'column' -%}
                <section class="set{% if b.settings.wide %} wide{% endif %}" {{ b.shopify_attributes }}>
                  <h4><span>{{ b.settings.heading }}</span><i></i></h4>
                  {%- if b.settings.said != blank -%}<span class="said">{{ b.settings.said }}</span>{%- endif -%}
                  <ul>
                    {%- assign rows = b.settings.links | newline_to_br | split: '<br />' -%}
                    {%- for row in rows -%}
                      {%- assign r = row | strip -%}
                      {%- if r != blank -%}
                        {%- assign p = r | split: '|' -%}
                        {%- assign label = p[0] | strip -%}
                        {%- assign url = p[1] | default: '#' | strip -%}
                        {%- assign val = p[2] | strip -%}
                        {%- if val != blank -%}
                          <li><a class="row" href="{{ url }}"><span class="k">{{ label }}</span><span class="v">{{ val }}</span></a></li>
                        {%- else -%}
                          <li><a class="go" href="{{ url }}">{{ label }}</a></li>
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </section>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        {%- assign talks = section.blocks | where: 'type', 'contact' -%}
        {%- if talks.size > 0 -%}
          <div class="reach">
            {%- for b in talks -%}
              <a href="{{ b.settings.link | default: '#' }}" {{ b.shopify_attributes }}>
                {%- case b.settings.icon -%}
                  {%- when 'mail' -%}
                    <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5.5" width="18" height="13" rx="2.4" stroke="currentColor" stroke-width="1.7"/><path d="M3.8 7l8.2 6 8.2-6" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
                  {%- when 'pin' -%}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11z" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="10" r="2.6" stroke="currentColor" stroke-width="1.7"/></svg>
                  {%- when 'phone' -%}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M6.5 3.5h3l1.6 4-2 1.4a12 12 0 0 0 6 6l1.4-2 4 1.6v3c0 1.1-.9 2-2 2A15.5 15.5 0 0 1 4.5 5.5c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M20.4 11.8a8.4 8.4 0 0 1-12.4 7.4L3.6 20.4l1.4-4.3a8.4 8.4 0 1 1 15.4-4.3z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
                {%- endcase -%}
                <span><b>{{ b.settings.title }}</b>{% if b.settings.note != blank %}<small>{{ b.settings.note }}</small>{% endif %}</span>
              </a>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="foot">
          {%- if s.show_join -%}
            {%- form 'customer' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="join">
                <div class="why">
                  <b>{{ s.join_title }}</b>
                  {%- if s.join_text != blank -%}<small>{{ s.join_text }}</small>{%- endif -%}
                </div>
                <div class="slot">
                  <input type="email" name="contact[email]" required placeholder="{{ s.join_hint }}">
                  <button type="submit">{{ s.join_btn }}</button>
                </div>
              </div>
            {%- endform -%}
          {%- endif -%}

          <div class="tail">
            {% render 'sa-social', sid: sid, blocks: section.blocks, style: s.soc_style, size: s.soc_size, radius: s.soc_radius, gap: s.soc_gap, ring: s.soc_ring, ring_col: s.soc_ring_col, lift: s.soc_lift, mono_bg: s.soc_mono_bg, mono_ink: s.soc_mono_ink %}
            <span class="law">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}{% if s.law != blank %} · {{ s.law }}{% endif %}</span>
          </div>
        </div>

      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer — SYNOR",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "The twine" },
    { "type": "image_picker", "id": "twine", "label": "Twine photo", "info": "Wide transparent PNG, bow in the centre." },
    { "type": "range", "id": "twine_max", "min": 400, "max": 1600, "step": 20, "unit": "px", "label": "Twine width", "info": "Wider makes the rope look thicker.", "default": 900 },
    { "type": "range", "id": "twine_w", "min": 60, "max": 100, "step": 1, "unit": "%", "label": "Twine width on phones", "default": 94 },
    { "type": "range", "id": "twine_y", "min": -60, "max": 60, "step": 2, "unit": "px", "label": "Move the twine up or down", "default": 0 },
    { "type": "image_picker", "id": "twine_d", "label": "Twine photo — desktop", "info": "For the rope to run the whole width of a desktop it has to be drawn long and thin, not scaled up: a photo about 15:1 (e.g. 4800×320), bow in the middle, flat rope running right to both edges, transparent PNG. Leave this empty and the phone photo is used at a size of its own instead." },
    { "type": "range", "id": "twine_d_h", "min": 80, "max": 320, "step": 5, "unit": "px", "label": "Twine height — desktop", "info": "Only used with the desktop photo. The rope keeps this height at every window width; the ends are cropped, never the bow.", "default": 170 },

    { "type": "header", "content": "The seal" },
    { "type": "image_picker", "id": "seal", "label": "Wax seal photo", "info": "Transparent PNG. Replaces the drawn seal." },
    { "type": "image_picker", "id": "seal_logo", "label": "Logo inside the drawn seal" },
    { "type": "range", "id": "seal_logo_size", "min": 20, "max": 70, "step": 2, "unit": "%", "label": "Logo size inside the seal", "default": 46 },
    { "type": "text", "id": "seal_letter", "label": "Or a letter", "default": "S" },
    { "type": "text", "id": "seal_text", "label": "Words around the seal", "default": "SURAT · EST MMXXV · SURAT · EST MMXXV ·" },
    { "type": "range", "id": "seal_size", "min": 60, "max": 200, "step": 2, "unit": "px", "label": "Seal size", "default": 88 },
    { "type": "range", "id": "seal_tilt", "min": -20, "max": 20, "step": 1, "label": "Wax tilt", "info": "Anything you upload stays upright.", "default": -6 },

    { "type": "header", "content": "The torn edge" },
    { "type": "range", "id": "tear_pad", "min": 30, "max": 140, "step": 2, "unit": "px", "label": "Space below the tear", "default": 58 },

    { "type": "header", "content": "Handwriting" },
    { "type": "select", "id": "hand_font", "label": "Style", "default": "Caveat",
      "options": [
        { "value": "Caveat", "label": "Caveat — quick notes" },
        { "value": "Kalam", "label": "Kalam — marker pen" },
        { "value": "Shadows Into Light", "label": "Shadows — light and airy" },
        { "value": "Indie Flower", "label": "Indie — round and friendly" },
        { "value": "Dancing Script", "label": "Dancing — flowing" },
        { "value": "Homemade Apple", "label": "Homemade — old fountain pen" },
        { "value": "Sacramento", "label": "Sacramento — fine and elegant" },
        { "value": "Gochi Hand", "label": "Gochi — bold and casual" }
      ] },

    { "type": "header", "content": "The note" },
    { "type": "textarea", "id": "note", "label": "Handwritten note", "default": "I did not want you to guess. So I put the whole shop in a ₹49 bottle and sent it to your door — and if you buy it, that ₹49 comes back to you." },
    { "type": "select", "id": "note_align", "label": "Note alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" } ] },
    { "type": "range", "id": "note_size", "min": 15, "max": 40, "step": 1, "unit": "px", "label": "Note size", "default": 25 },

    { "type": "header", "content": "The signature" },
    { "type": "image_picker", "id": "sign_image", "label": "Signature image" },
    { "type": "text", "id": "sign_text", "label": "Or a written signature", "default": "Sagar" },
    { "type": "select", "id": "sign_align", "label": "Signature position", "default": "right",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" } ] },
    { "type": "range", "id": "sign_size", "min": 18, "max": 56, "step": 1, "unit": "px", "label": "Signature size", "default": 30 },
    { "type": "range", "id": "sign_gap", "min": -20, "max": 40, "step": 1, "unit": "px", "label": "Space above the signature", "default": 2 },

    { "type": "header", "content": "The pen" },
    { "type": "checkbox", "id": "show_pen", "label": "Show the pen", "default": true },
    { "type": "range", "id": "pen_size", "min": 26, "max": 90, "step": 2, "unit": "px", "label": "Pen size", "default": 46 },
    { "type": "range", "id": "pen_x", "min": -80, "max": 80, "step": 2, "unit": "px", "label": "Move left or right", "default": 2 },
    { "type": "range", "id": "pen_y", "min": -60, "max": 40, "step": 2, "unit": "px", "label": "Move up or down", "info": "Lower numbers move it down.", "default": -8 },
    { "type": "range", "id": "pen_tilt", "min": 0, "max": 90, "step": 1, "label": "Pen angle", "default": 40 },

    { "type": "header", "content": "The mark" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "info": "Wrap a letter in | ~ to make it gold.", "default": "SY|N~OR" },
    { "type": "text", "id": "tagline", "label": "Line under it", "default": "Extrait de Parfum · 30% Oil · Surat" },

    { "type": "header", "content": "Sign-up" },
    { "type": "checkbox", "id": "show_join", "label": "Show it", "default": true },
    { "type": "text", "id": "join_title", "label": "Heading", "default": "Letters from the bench" },
    { "type": "text", "id": "join_text", "label": "Text", "default": "A note only when something new is blended." },
    { "type": "text", "id": "join_hint", "label": "Placeholder", "default": "Email address" },
    { "type": "text", "id": "join_btn", "label": "Button", "default": "Join" },
    { "type": "text", "id": "law", "label": "After the year", "default": "All rights reserved" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "min": 20, "max": 90, "step": 2, "unit": "px", "label": "Space above the tear", "default": 40 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "behind", "label": "Behind the tear", "default": "#FFFDF8" },
    { "type": "color", "id": "paper", "label": "Paper", "default": "#F2EAD8" },
    { "type": "color", "id": "ink", "label": "Headings", "default": "#1A1712" },
    { "type": "color", "id": "body", "label": "Links", "default": "#5A5245" },
    { "type": "color", "id": "mute", "label": "Muted text", "default": "#8A8272" },
    { "type": "color", "id": "gold", "label": "Gold", "default": "#A8873F" },
    { "type": "color", "id": "gold2", "label": "Gold light", "default": "#E4CE9E" },
    { "type": "color", "id": "gold_dark", "label": "Gold dark", "default": "#8C6B2E" },
    { "type": "color_background", "id": "line", "label": "Hairlines", "default": "rgba(168,135,63,0.26)" },
    { "type": "header", "content": "Social icons" },
    { "type": "select", "id": "soc_style", "label": "Style", "default": "colour",
      "options": [
        { "value": "colour", "label": "Brand colours" },
        { "value": "gold", "label": "One SYNOR tone" },
        { "value": "outline", "label": "Outline only" }
      ] },
    { "type": "range", "id": "soc_size", "min": 26, "max": 56, "step": 2, "unit": "px", "label": "Tile size", "default": 36 },
    { "type": "range", "id": "soc_radius", "min": 0, "max": 28, "step": 1, "unit": "px", "label": "Tile roundness", "default": 11 },
    { "type": "range", "id": "soc_gap", "min": 4, "max": 24, "step": 1, "unit": "px", "label": "Gap between icons", "default": 8 },
    { "type": "range", "id": "soc_lift", "min": 0, "max": 6, "step": 1, "unit": "px", "label": "Lift on hover", "default": 2 },
    { "type": "checkbox", "id": "soc_ring", "label": "Gold hairline around each tile", "default": true },
    { "type": "color", "id": "soc_ring_col", "label": "Hairline colour", "default": "#BE9A54" },
    { "type": "color", "id": "soc_mono_bg", "label": "One-tone: tile colour", "default": "#1A1712" },
    { "type": "color", "id": "soc_mono_ink", "label": "One-tone: icon colour", "default": "#F7F3EA" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "What we make" },
        { "type": "text", "id": "said", "label": "Handwritten note under it", "default": "fifty, so far" },
        { "type": "textarea", "id": "links", "label": "Links", "info": "One per line.  Label | /url | optional answer", "default": "Every scent | /collections/all-products" },
        { "type": "checkbox", "id": "wide", "label": "Full width on phones", "default": false }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "whatsapp",
          "options": [
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "mail", "label": "Email" },
            { "value": "pin", "label": "Location" },
            { "value": "phone", "label": "Phone" }
          ] },
        { "type": "text", "id": "title", "label": "Title", "default": "WhatsApp us" },
        { "type": "text", "id": "note", "label": "Small line", "default": "Usually replies within the hour" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "social",
      "name": "Social",
      "limit": 6,
      "settings": [
        { "type": "select", "id": "kind", "label": "Which", "default": "instagram",
          "options": [
            { "value": "instagram", "label": "Instagram" },
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "facebook", "label": "Facebook" },
            { "value": "youtube", "label": "YouTube" }
          ] },
        { "type": "text", "id": "label", "label": "Name", "default": "Instagram" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Footer — SYNOR" }]
}
{% endschema %}